# Apptainer/Singularity Definition File
# This file is used to build a container with the Magma library.
# This version installs the core library ONLY, without server components.

Bootstrap: docker
From: pytorch/pytorch:2.3.1-cuda12.1-cudnn8-devel

################################################################################
# HELP SECTION
################################################################################
%help
    This container provides an environment with the Magma library installed.
    It is built from the pytorch/pytorch:2.3.1-cuda12.1-cudnn8-devel base image.

    To build this container:
    sudo apptainer build magma-lib.sif magma.def

    To run an interactive shell inside the container:
    apptainer run --nv magma-lib.sif
    
    Once inside, you can use python and the magma library.

################################################################################
# POST SECTION
# Corresponds to the RUN instructions in the Dockerfile.
# Commands in this section are executed inside the container *during* the build process.
################################################################################
%post
    # Set CUDA environment variables for the build process
    export CUDA_HOME="/usr/local/cuda"
    export PATH="${CUDA_HOME}/bin:${PATH}"
    export LD_LIBRARY_PATH="${CUDA_HOME}/lib64:${LD_LIBRARY_PATH}"

    # Install system dependencies, same as in the Dockerfile
    echo "Updating package lists and installing dependencies..."
    apt-get update && apt-get install -y \
        build-essential \
        git \
        wget \
        ninja-build \
    && rm -rf /var/lib/apt/lists/*
    echo "Dependencies installed."

    # The files from the host are copied into /app by the %files section.
    # We now install the base Magma library.
    echo "Installing core Magma library..."
    cd /app
    # Changed from ".[server]" to "." to install only the core library
    pip install -e .
    echo "Installation complete."

################################################################################
# FILES SECTION
# Corresponds to the COPY instruction in the Dockerfile.
# This section copies files from the host system (where you are building)
# into the container image.
################################################################################
%files
    # Copy the entire build context (current directory) into the /app directory
    # inside the container. This runs before the %post section.
    . /app

################################################################################
# ENVIRONMENT SECTION
# Corresponds to the ENV instructions in the Dockerfile.
# Sets environment variables that will be available when the container is run.
################################################################################
%environment
    # Set CUDA environment variables for runtime
    export CUDA_HOME="/usr/local/cuda"
    export PATH="${CUDA_HOME}/bin:${PATH}"
    export LD_LIBRARY_PATH="${CUDA_HOME}/lib64:${LD_LIBRARY_PATH}"

    # Set application-specific environment variables
    export MODEL_ID="microsoft/Magma-8B"
    # Removed PORT variable as the server is not being run.

################################################################################
# RUNSCRIPT SECTION
# Corresponds to the CMD instruction in the Dockerfile.
# This script is now set to launch a shell for interactive use.
################################################################################
%runscript
    echo "Launching interactive shell in Magma container..."
    echo "You can now run your python scripts or start a python interpreter."
    # The 'exec' command replaces this script with a bash shell.
    # "$@" passes any command-line arguments to the shell.
    exec /bin/bash "$@"
