Bootstrap: docker
From: nvidia/cuda:12.1.1-devel-ubuntu22.04
 
%environment
    export PATH=/opt/conda/envs/myenv/bin:/opt/conda/bin:$PATH
    export CUDA_VISIBLE_DEVICES=0
    export PYTHONPATH=/opt/conda/envs/myenv/lib/python3.10/site-packages:$PYTHONPATH
 
%post
    # Update package lists and install essential system dependencies
    apt-get update && apt-get install -y \
        git \
        python3 \
        python3-pip \
        python3-venv \
        build-essential
    pip install --no-cache-dir wheel setuptools;
    pip install --no-cache-dir packaging;
    pip install --no-cache-dir torch==2.3.1;
 
 
%runscript
    exec bash